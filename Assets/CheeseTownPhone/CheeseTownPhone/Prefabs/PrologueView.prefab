--- !u!114 &78919783142101582
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3647126022087448564}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e681841f3b974003b1c456ff8a869c06, type: 3}
  m_Name:
  m_EditorClassIdentifier: Assembly-CSharp::CheeseTownPhone.PrologueView
  chapters:
  - title:
    body: 'For generations, the Great Cheese Tree

      has sheltered the mice of Mousetown.

      Now its branches have fallen silent.'
    background: {fileID: 21300000, guid: 7e1f0da8c75309b4bbdeeb6bc5ea145e, type: 3}
  - title:
    body: 'Winter is drawing near.

      The storerooms are empty,

      and our old guardian is fading.'
    background: {fileID: 21300000, guid: 6f9b526b3e81a3a4ab5267ddb7648cf3, type: 3}
  - title:
    body: 'Leo, gather cheese beyond the town.

      Help us weather the cold...

      and bring our Great Tree back to life.'
    background: {fileID: 21300000, guid: 73851bc577b4c0c4ea6b7d37ca85145c, type: 3}
