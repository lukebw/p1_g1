--- !u!114 &5873242272664128238
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2636439964178387564}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e681841f3b974003b1c456ff8a869c06, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CheeseTownPhone.PrologueView
  chapters:
  - title: 
    body: 'Winter''s hunger had long since passed.

      Still, you brought more cheese home.

      The shelves filled. Then the streets.'
    background: {fileID: 21300000, guid: 73851bc577b4c0c4ea6b7d37ca85145c, type: 3}
  - title: 
    body: 'The cheese rose past windows and rooftops.

      The mice fled while the roads were clear.

      Soon, even the Great Tree disappeared.'
    background: {fileID: 21300000, guid: 7e1f0da8c75309b4bbdeeb6bc5ea145e, type: 3}
  - title: 
    body: 'You gathered too much cheese.

      Mousetown lay buried beneath the harvest.

      There was food for everyone...

      and no home left to share it.'
    background: {fileID: 21300000, guid: 6f9b526b3e81a3a4ab5267ddb7648cf3, type: 3}
  background: {fileID: 5292111877940979636}
